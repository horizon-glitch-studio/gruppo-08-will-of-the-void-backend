{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battle Viewer Document",
  "description": "A self-contained battle record for replaying a match in the frontend viewer. The server stores the player snapshots in battle.decks_snapshot and the events in battle.turn_log; the replay API rebuilds this document from those two columns and the battle row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "battleId",
    "mode",
    "rules",
    "players",
    "events",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "battleId": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "FRIEND",
        "QUICK",
        "RANKED"
      ]
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/playerSnapshot"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "side": {
                "const": "A"
              }
            },
            "required": [
              "side"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "side": {
                "const": "B"
              }
            },
            "required": [
              "side"
            ]
          }
        }
      ],
      "description": "The two player snapshots. Each side must appear exactly once."
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/cardDeployedEvent"
          },
          {
            "$ref": "#/$defs/roundResolvedEvent"
          },
          {
            "$ref": "#/$defs/clashResolvedEvent"
          },
          {
            "$ref": "#/$defs/deckExhaustedEvent"
          },
          {
            "$ref": "#/$defs/battleFinishedEvent"
          }
        ]
      },
      "description": "Chronological event stream ordered by sequence. A card is identified by its side and its position in the shuffled deck."
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "$defs": {
    "side": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "energyBySide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "type": "integer",
          "minimum": 0
        },
        "B": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "energyWinThreshold",
        "endBonusPerCard"
      ],
      "properties": {
        "energyWinThreshold": {
          "type": "integer",
          "minimum": 1,
          "description": "The match ends when a player's Energy reaches this value: 30 in FRIEND and RANKED, 20 in QUICK."
        },
        "endBonusPerCard": {
          "type": "integer",
          "minimum": 0,
          "description": "Energy given at deck exhaustion for every card a player still has, the card in the Arena included."
        }
      }
    },
    "cardSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deckPosition",
        "cardId",
        "name",
        "faction",
        "rarity",
        "baseAttack",
        "baseDefense"
      ],
      "properties": {
        "deckPosition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29,
          "description": "Zero-based position in this shuffled deck. Together with the side, it identifies the card in the events."
        },
        "cardId": {
          "type": "integer",
          "minimum": 1,
          "description": "Catalog card id (card.id)."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "faction": {
          "$ref": "#/$defs/faction"
        },
        "rarity": {
          "$ref": "#/$defs/rarity"
        },
        "baseAttack": {
          "type": "integer",
          "minimum": 1,
          "description": "Card ATK, without faction advantage."
        },
        "baseDefense": {
          "type": "integer",
          "minimum": 1,
          "description": "Card DEF at the start of the battle."
        }
      }
    },
    "playerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "playerId",
        "displayName",
        "deckSnapshot"
      ],
      "properties": {
        "side": {
          "$ref": "#/$defs/side"
        },
        "playerId": {
          "type": "integer",
          "minimum": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "deckSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shuffleApplied",
            "cards"
          ],
          "properties": {
            "shuffleApplied": {
              "type": "boolean",
              "const": true
            },
            "cards": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cardSnapshot"
              },
              "description": "Cards in their actual post-shuffle draw order.",
              "minItems": 30,
              "maxItems": 30
            }
          }
        }
      },
      "description": "Every player starts the battle with 0 Energy."
    },
    "eventBase": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based position in the complete event stream."
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "type"
      ]
    },
    "cardDeployedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "type",
            "clashNumber",
            "side",
            "deckPosition",
            "defenseAtDeployment"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "CARD_DEPLOYED"
            },
            "clashNumber": {
              "type": "integer",
              "minimum": 1
            },
            "side": {
              "$ref": "#/$defs/side"
            },
            "deckPosition": {
              "type": "integer",
              "minimum": 0
            },
            "defenseAtDeployment": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "roundCardState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "deckPosition",
        "attackUsed",
        "advantageApplied",
        "defenseBefore",
        "damageTaken",
        "defenseAfter",
        "defeated"
      ],
      "properties": {
        "side": {
          "$ref": "#/$defs/side"
        },
        "deckPosition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29
        },
        "attackUsed": {
          "type": "integer",
          "minimum": 1,
          "description": "This card's effective ATK: base ATK, plus the faction advantage when it applies."
        },
        "advantageApplied": {
          "type": "boolean",
          "description": "True when this card's faction prevails over the opposing card's faction."
        },
        "defenseBefore": {
          "type": "integer",
          "minimum": 1
        },
        "damageTaken": {
          "type": "integer",
          "minimum": 1,
          "description": "Equal to the opposing card's attackUsed for this round."
        },
        "defenseAfter": {
          "type": "integer",
          "description": "Defense after simultaneous damage; values at or below zero mean the card is defeated."
        },
        "defeated": {
          "type": "boolean",
          "description": "True exactly when defenseAfter is less than or equal to zero."
        }
      }
    },
    "roundResolvedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "type",
            "clashNumber",
            "roundNumber",
            "cards"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "ROUND_RESOLVED"
            },
            "clashNumber": {
              "type": "integer",
              "minimum": 1,
              "description": "The card-versus-card clash containing this round."
            },
            "roundNumber": {
              "type": "integer",
              "minimum": 1,
              "description": "One-based round number within the current clash."
            },
            "cards": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/roundCardState"
              },
              "description": "Both active cards after simultaneous damage; one entry for side A and one for side B."
            }
          }
        }
      ]
    },
    "clashCardOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "deckPosition",
        "finalDefense",
        "defeated"
      ],
      "properties": {
        "side": {
          "$ref": "#/$defs/side"
        },
        "deckPosition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29
        },
        "finalDefense": {
          "type": "integer"
        },
        "defeated": {
          "type": "boolean"
        }
      }
    },
    "energyAward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipientSide",
        "defeatedSide",
        "amount"
      ],
      "properties": {
        "recipientSide": {
          "$ref": "#/$defs/side"
        },
        "defeatedSide": {
          "$ref": "#/$defs/side"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Absolute value of the defeated card's negative defense; zero when its final defense is exactly zero."
        }
      }
    },
    "clashResolvedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "type",
            "clashNumber",
            "outcome",
            "cards",
            "energyAward",
            "energyAfter"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "CLASH_RESOLVED"
            },
            "clashNumber": {
              "type": "integer",
              "minimum": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "BOTH_DEFEATED",
                "A_DEFEATED",
                "B_DEFEATED"
              ],
              "description": "A_DEFEATED or B_DEFEATED names the side whose card was defeated."
            },
            "cards": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/clashCardOutcome"
              }
            },
            "energyAward": {
              "anyOf": [
                {
                  "$ref": "#/$defs/energyAward"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Null when both cards are defeated; otherwise records the surviving side's award."
            },
            "energyAfter": {
              "$ref": "#/$defs/energyBySide"
            }
          }
        }
      ]
    },
    "deckExhaustedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "type",
            "exhaustedSide",
            "remainingCardsBySide",
            "bonusPerCard",
            "bonusAwardedBySide",
            "energyAfter"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "DECK_EXHAUSTED"
            },
            "exhaustedSide": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "BOTH"
              ],
              "description": "The side that has to deploy a card and has none left; BOTH when both cards were defeated and both decks are empty."
            },
            "remainingCardsBySide": {
              "$ref": "#/$defs/energyBySide",
              "description": "Cards each player still has: undeployed cards plus the card in the Arena, if it survived."
            },
            "bonusPerCard": {
              "type": "integer",
              "minimum": 0
            },
            "bonusAwardedBySide": {
              "$ref": "#/$defs/energyBySide",
              "description": "remainingCardsBySide multiplied by bonusPerCard."
            },
            "energyAfter": {
              "$ref": "#/$defs/energyBySide"
            }
          }
        }
      ]
    },
    "battleFinishedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "type",
            "endReason",
            "winnerSide",
            "finalEnergyBySide"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "BATTLE_FINISHED"
            },
            "endReason": {
              "$ref": "#/$defs/endReason"
            },
            "winnerSide": {
              "$ref": "#/$defs/winnerSide"
            },
            "finalEnergyBySide": {
              "$ref": "#/$defs/energyBySide"
            }
          }
        }
      ]
    },
    "endReason": {
      "type": "string",
      "enum": [
        "ENERGY_THRESHOLD",
        "DECK_EXHAUSTED"
      ]
    },
    "winnerSide": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "DRAW"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endReason",
        "winnerSide",
        "finalEnergyBySide"
      ],
      "properties": {
        "endReason": {
          "$ref": "#/$defs/endReason"
        },
        "winnerSide": {
          "$ref": "#/$defs/winnerSide"
        },
        "finalEnergyBySide": {
          "$ref": "#/$defs/energyBySide"
        }
      },
      "description": "Convenience summary matching the final BATTLE_FINISHED event."
    },
    "faction": {
      "type": "string",
      "enum": [
        "Lava",
        "Electro",
        "Radio",
        "Ice",
        "Metal",
        "Matte",
        "Gem",
        "Noble Gas"
      ]
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Captive",
        "Conscript",
        "Soldier",
        "Champion",
        "Elect",
        "Wanderer"
      ]
    }
  }
}
